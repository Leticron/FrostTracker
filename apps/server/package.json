    "@fht/rules": "workspace:*",
    "@fht/shared": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "@trpc/server": "11.19.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
