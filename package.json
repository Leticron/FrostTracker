{
  "name": "frosthaven-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fht/server --filter @fht/web dev",
    "build": "pnpm --filter @fht/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm build && playwright test",
    "db:generate": "pnpm --filter @fht/server db:generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "@testcontainers/postgresql": "12.2.0"
  }
}
