# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Public host name served by Traefik (no scheme), e.g. frosthaven.example.com
APP_HOST=
# Traefik: external network name, entrypoint and certificate resolver
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=
# Optional: CIDR(s) of your Traefik network if you want to narrow the trusted proxies
# TRUSTED_PROXIES=172.18.0.0/16

# Database
POSTGRES_USER=frosthaven
POSTGRES_PASSWORD=
POSTGRES_DB=frosthaven

# Host paths (Unraid defaults)
DB_PATH=/mnt/user/appdata/frosthaven-tracker/db
ASSETS_PATH=/mnt/user/appdata/frosthaven-tracker/assets
SEED_PATH=/mnt/user/appdata/frosthaven-tracker/seed

# First start: creates the site admin if none exists (ignored afterwards; remove after first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Open self-registration (default: invite links only)
ALLOW_REGISTRATION=false
SESSION_TTL_DAYS=30
LOG_LEVEL=info
