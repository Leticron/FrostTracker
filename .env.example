# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Public host name served by Traefik (no scheme), e.g. frosthaven.example.com
APP_HOST=
# Traefik: external network name, entrypoint and certificate resolver
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=
# Recommended: CIDR(s) of your Traefik network, so LAN clients can't fake X-Forwarded-For
# (find it with: docker network inspect traefik -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}')
# TRUSTED_PROXIES=172.18.0.0/16

# Port the app listens on and publishes on the host. Pick one that is free on the server
# (check with: ss -tln | grep :3000). APP_BIND=127.0.0.1 limits it to the server itself.
APP_PORT=3000
APP_BIND=0.0.0.0

# Database
POSTGRES_USER=frosthaven
POSTGRES_PASSWORD=
POSTGRES_DB=frosthaven

# Host paths (Unraid defaults)
DB_PATH=/mnt/user/appdata/frosthaven-tracker/db
ASSETS_PATH=/mnt/user/appdata/frosthaven-tracker/assets
SEED_PATH=/mnt/user/appdata/frosthaven-tracker/seed

# First start: creates the site admin if none exists (ignored afterwards; remove after first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Open self-registration (default: invite links only)
ALLOW_REGISTRATION=false
SESSION_TTL_DAYS=30
LOG_LEVEL=info

# App image (published by GitHub Actions). Pin a version tag (e.g. 1.0.0) for controlled updates.
APP_IMAGE=ghcr.io/leticron/frosttracker
APP_VERSION=latest

# Backups: daily pg_dump at BACKUP_TIME (in TZ), kept for BACKUP_KEEP_DAYS days
BACKUP_PATH=/mnt/user/appdata/frosthaven-tracker/backups
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
TZ=Europe/Berlin
